<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 (API < 31) auto-backup configuration for Feya PDF.

  This app handles sensitive material (encrypted PDFs, PIN hashes,
  biometric passphrases). Excluding every path keeps that data out of
  Google's auto-backup cloud storage.

  Used as android:fullBackupContent="@xml/backup_rules" in
  AndroidManifest.xml.
-->
<full-backup-content>
    <!-- Explicitly include nothing — defence in depth alongside
         android:allowBackup="false" on the <application> tag. -->
</full-backup-content>
