<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) data extraction rules for Freya PDF.

  Used as android:dataExtractionRules="@xml/data_extraction_rules" in
  AndroidManifest.xml. Both device-to-device transfer and cloud backup
  are explicitly disabled — Freya stores encrypted PDFs, PIN hashes and
  biometric passphrases that must never leave the device via OS-level
  flows.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- Empty <include> list means nothing is backed up to cloud. -->
    </cloud-backup>
    <device-transfer>
        <!-- Empty <include> list means nothing is migrated on device transfer. -->
    </device-transfer>
</data-extraction-rules>
